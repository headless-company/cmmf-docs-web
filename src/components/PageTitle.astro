---
import VersionSelector from './VersionSelector.astro';
import { editionFor, topicPath } from '../../scripts/lib/versions.mjs';
const edition = editionFor(Astro.url.pathname);
const topic = topicPath(Astro.url.pathname);
const { entry } = Astro.locals.starlightRoute;
const home = Astro.url.pathname === '/';
const reference = topic.startsWith('/docs/reference/') || Astro.url.pathname.startsWith('/spec/');
const archive = Astro.url.pathname.startsWith('/spec/1.1.0/');
const specification = Astro.url.pathname.startsWith('/spec/');
const suffix = Astro.url.pathname.endsWith('/translation-contract/') ? 'translation-contract/' : '';
---
<span hidden data-pagefind-filter={`version:${edition.version}`}></span>
{!home && <div class:list={['page-heading', reference ? 'reference-title' : 'reading-title']}>
  <div class="page-eyebrow"><span>{reference ? 'Format reference' : 'Content modelling'}</span><span class="version-badge">{archive ? '1.1.0 · Archived' : `CMMF ${edition.version}${edition.version.includes('beta') ? ' · Experimental' : ''}`} </span></div>
  <h1 id="_top">{entry.data.title}</h1>
  {entry.data.description && <p class="page-description">{entry.data.description}</p>}
  <VersionSelector />
  {edition.version.includes('beta') && <aside class="edition-notice" data-pagefind-ignore>Experimental prerelease. <a href="/docs/">1.2.0 remains stable</a>. Select the exact beta schema and manifest version; hints declare intent and do not evaluate content.</aside>}
  {specification && <nav class="spec-versions" aria-label="Specification versions">
    <span>Read this document in</span>
    <a href={`/spec/1.2.0/${suffix}`} aria-current={!archive && edition.version === '1.2.0' ? 'page' : undefined}>1.2.0 · Current</a>
    <a href={`/spec/1.3.0-beta.1/${suffix}`} aria-current={edition.version.includes('beta') ? 'page' : undefined}>1.3.0-beta.1 · Experimental</a>
    <a href={`/spec/1.1.0/${suffix}`} aria-current={archive ? 'page' : undefined}>1.1.0 · Archived</a>
  </nav>}
</div>}
