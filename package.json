{
  "name": "cmmf-docs-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs && node scripts/prepare-versions.mjs",
    "dev": "npm run prepare:content && astro dev --host 127.0.0.1",
    "build": "npm run source:check && npm run examples:check && npm run test:examples && npm run test:beta && npm run prepare:content && astro build && node scripts/check-site.mjs && node scripts/check-versions.mjs && node scripts/check-skills.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "source:check": "node scripts/sync-cmmf.mjs --check && node scripts/sync-cmmf.mjs --check --snapshot vendor/cmmf-beta --lock cmmf-beta-source.lock.json",
    "handover:check": "node artifacts/cmmf-site-handover/scripts/verify-handover.mjs",
    "examples:check": "node scripts/check-examples.mjs",
    "check": "npm run prepare:content && astro check",
    "test:browser": "node scripts/review-site.mjs",
    "test:examples": "node --test scripts/test-model-set.mjs",
    "assets:social": "node scripts/render-social.mjs",
    "test:beta": "node --test vendor/cmmf-beta/test/validation-hints.test.mjs && node scripts/check-beta.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.56.0",
    "ajv": "^8.17.1",
    "beautiful-mermaid": "1.1.3",
    "cheerio": "^1.1.2",
    "fflate": "0.8.3",
    "typescript": "~5.9.3",
    "yaml": "^2.8.1"
  }
}
